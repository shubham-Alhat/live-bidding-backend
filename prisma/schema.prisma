generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



model User {
  id               String    @id @default(cuid())
  username         String
  email            String    @unique
  password         String
  refreshToken     String?
  isVerifiedSeller Boolean   @default(false)
  products         Product[] @relation("UserOwnsProduct")
  auctions         Auction[] @relation("UserOwnsAuction")
  winningAuctions  Auction[] @relation("UserWonAuction")
  bids             Bid[]     @relation("UserPlacedBid")
  shows            Show[]    @relation("UserownsShows")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Product {
  id           String    @id @default(cuid())
  name         String
  description  String
  image        String
  initialPrice Decimal
  ownerId      String
  owner        User      @relation("UserOwnsProduct", fields: [ownerId], references: [id], onDelete: Restrict)
  auctions     Auction[] @relation("ProductHasAuction")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@index([ownerId])
}

model Bid {
  id       String   @id @default(cuid())
  price    Decimal
  
  bidderId String
  bidder   User     @relation("UserPlacedBid", fields: [bidderId], references: [id], onDelete: Restrict)

  auctionId String
  auction   Auction @relation("AuctionHasBid", fields: [auctionId], references: [id], onDelete: Cascade)

  // reverse side of Auction.winningBid — nullable, this Bid may or may not be a winner
  winningAuction Auction? @relation("AuctionWinningBid")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([auctionId])
  @@index([bidderId])
}

enum STATUS {
  SCHEDULED
  ACTIVE
  ENDED
}

model Auction {
  id              String   @id @default(cuid())

  ownerId         String
  owner           User     @relation("UserOwnsAuction", fields: [ownerId], references: [id], onDelete: Restrict)

  winnerId        String?
  winner          User?    @relation("UserWonAuction", fields: [winnerId], references: [id], onDelete: SetNull)

  winningBidId    String?  @unique
  winningBid      Bid?     @relation("AuctionWinningBid", fields: [winningBidId], references: [id], onDelete: SetNull)

  biddings        Bid[]    @relation("AuctionHasBid")

  productId       String
  product         Product  @relation("ProductHasAuction", fields: [productId], references: [id], onDelete: Cascade)

  startTime       DateTime
  auctionDuration Int
  startingPrice   Decimal
  finalBidPrice   Decimal?

  status          STATUS   @default(SCHEDULED)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId])
  @@index([ownerId])
}


model Show {
  id              String   @id @default(cuid())
  name            String
  description     String
  thumbnail       String
  ownerId         String
  owner           User     @relation("UserownsShows", fields: [ownerId], references: [id], onDelete: Cascade)
  status          STATUS   @default(SCHEDULED)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

}



